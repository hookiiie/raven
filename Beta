local function formatTime(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    if hours > 0 then
        return string.format("%02d:%02d:%02d", hours, minutes, secs)
    end
    return string.format("%02d:%02d", minutes, secs)
end

local moneyStat
local moneyStart = 0
local collectedMoney = 0
local moneyConnection

local function findMoneyStat()
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return nil end
    local preferred = {
        "Money", "Cash", "Coins", "Gold",
        "Dollars", "Currency", "Credits"
    }
    for _, name in ipairs(preferred) do
        local value = leaderstats:FindFirstChild(name)
        if value and (value:IsA("IntValue") or value:IsA("NumberValue")) then
            return value
        end
    end
    for _, child in ipairs(leaderstats:GetChildren()) do
        if child:IsA("IntValue") or child:IsA("NumberValue") then
            return child
        end
    end
    return nil
end

local function attachMoney()
    if moneyConnection then
        moneyConnection:Disconnect()
        moneyConnection = nil
    end
    moneyStat = findMoneyStat()
    if not moneyStat then return end
    moneyStart = moneyStat.Value
    collectedMoney = 0
    moneyConnection = moneyStat.Changed:Connect(function(value)
        if typeof(value) ~= "number" then return end
        local delta = value - moneyStart
        if delta >= 0 then
            collectedMoney = delta
        end
    end)
end

task.spawn(function()
    local leaderstats = player:WaitForChild("leaderstats", 15)
    if not leaderstats then return end
    attachMoney()
    leaderstats.ChildAdded:Connect(function()
        task.wait()
        if not moneyStat or not moneyStat.Parent then
            attachMoney()
        end
    end)
end)

