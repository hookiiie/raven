local function hideScripts()
    local c = LocalPlayer.Character
    if not c then return end
    for _, obj in ipairs(c:GetDescendants()) do
        if obj:IsA("LocalScript") then
            pcall(function()
                local mt = getrawmetatable(obj)
                if mt and isreadonly and not isreadonly(mt) then
                    local oldIndex = mt.__index
                    mt.__index = newcclosure(function(t, k)
                        if k == "Disabled" then return true end
                        if k == "Enabled" then return false end
                        return oldIndex(t, k)
                    end)
                end
            end)
        end
    end
end

local function spoofProperties()
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then
        pcall(function()
            local mt = getrawmetatable(h)
            if mt and isreadonly and not isreadonly(mt) then
                local oldIndex = mt.__index
                mt.__index = newcclosure(function(t, k)
                    if k == "WalkSpeed" or k == "JumpPower" then return 16 end
                    if k == "HipHeight" then return 2 end
                    return oldIndex(t, k)
                end)
            end
        end)
    end
end

local function disableAntiCheatConnections()
    if not getconnections then return end
    local services = { RunService.Heartbeat, RunService.Stepped }
    for _, signal in ipairs(services) do
        local ok, connections = pcall(getconnections, signal)
        if ok and connections then
            for _, conn in ipairs(connections) do
                local ok2, scr = pcall(function() return conn.Script end)
                if ok2 and scr then
                    local name = scr.Name:lower()
                    if name:find("anticheat") or name:find("ac_") or name:find("guard")
                       or name:find("_detect") or name:find("_watch") or name:find("_monitor")
                       or name:find("_check") or name:find("_scan") or name:find("_byfron")
                       or name:find("_hyperion") then
                        pcall(function() conn:Disconnect() end)
                    end
                end
            end
        end
    end
end

local function blockSuspiciousRemotes()
    if not hookmetamethod then return end
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            local name = self.Name:lower()
            if name:find("report") or name:find("flag") or name:find("_detect")
               or name:find("anticheat") or name:find("_ac_") or name:find("_ban_")
               or name:find("_kick_") or name:find("violation") or name:find("_honeypot")
               or name:find("_trap") or name:find("_log") or name:find("_telemetry")
               or name:find("_event") or name:find("_analytic") then return nil end
        end
        return oldNamecall(self, ...)
    end))
end

