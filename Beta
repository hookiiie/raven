local function getMe()
    local c = cache.me
    if c and c.Parent then return c end
    local living = cache.living
    if not living or not living.Parent then
        cache.living = safeWS:FindFirstChild("LivingThings")
        living = cache.living
    end
    if not living then return nil end
    cache.me = living:FindFirstChild(LocalPlayer.Name)
    return cache.me
end

local function carried()
    local me = getMe()
    if not me then return false end
    local crate = me:FindFirstChild("DeliveryCrate")
    if not crate then return false end
    return crate:FindFirstChild("Handle") ~= nil
end

local function findActive()
    local eps = getEPS()
    if not eps then return nil end
    local children = eps:GetChildren()
    local available = {}
    for i = 1, #children do
        local ep = children[i]
        local t = ep:FindFirstChild("TouchInterest")
        if t then tableInsert(available, ep) end
    end
    if #available == 0 then return nil end
    local best = pickBestEndpoint(available)
    if best then
        brain.lastEndpointName = best.Name
        return best, best:FindFirstChild("TouchInterest")
    end
    return nil
end

local function getEndpointPart(ep)
    local c = ep:FindFirstChildWhichIsA("BasePart")
    if c then return c end
    local desc = ep:GetDescendants()
    for i = 1, #desc do
        if desc[i]:IsA("BasePart") then return desc[i] end
    end
    return nil
end

local function stopHumanoid()
    if hum and hrp then
        hum:MoveTo(hrp.Position)
        pcall(function()
            hrp.AssemblyLinearVelocity = ZERO
            hrp.AssemblyAngularVelocity = ZERO
        end)
    end
end

local function waitForCrateDrop(timeout)
    local startTime = clock()
    while clock() - startTime < timeout do
        if not carried() then return true end
        task.wait()
    end
    return not carried()
end

local function goTakeChest()
    currentState = STATE.TAKING
    local chest = getChest()
    if not chest then return false end
    local prompt = cache.prompt
    if not prompt or not prompt.Parent then
        prompt = chest:FindFirstChildOfClass("ProximityPrompt")
        cache.prompt = prompt
    end
    if not prompt then return false end
    local chestPos = cache.chestPos or chest.Position

    walkToPart(chest, carried)

    local attempts = max(6, min(40, floor(brain.takeAttempts * brain.serverSpeed)))

    for i = 1, attempts do
        if carried() then stopHumanoid(); return true end
        if getDistanceTo(chestPos) > E_PRESS_MAX_DISTANCE then
            walkToPart(chest, carried)
        else
            local pressStart = tick()
            pcall(fireproximityprompt, prompt)
            profileServer((tick() - pressStart) * 1000)
            if carried() then stopHumanoid(); return true end
            task.wait(E_PRESS_INTERVAL)
        end
    end
    return false
end

local function goDeliver()
    currentState = STATE.DELIVERING
    local ep, touch = findActive()
    if not ep then return false end
    local part = getEndpointPart(ep)
    if not part then return false end

    local endpointName = ep.Name
    local deliverStartTime = clock()

    local function deliveryCheck() return not carried() end
    local function arriveCheck() return isInEndpointZone(part) end

    walkToPart(part, deliveryCheck, arriveCheck)

    local attempts = max(6, min(40, floor(brain.deliverAttempts * brain.serverSpeed)))

    for i = 1, attempts do
        if not carried() then
            stopHumanoid()
            updateEndpointScore(endpointName, true, clock() - deliverStartTime)
            return true
        end
        if not isInEndpointZone(part) then
            walkToPart(part, deliverCheck, arriveCheck)
        end
        pressSpace()
        if waitForCrateDrop(SPACE_PRESS_INTERVAL) then
            stopHumanoid()
            updateEndpointScore(endpointName, true, clock() - deliverStartTime)
            return true
        end
    end

    updateEndpointScore(endpointName, false)
    return false
end

local function rejoinGame()
    if isRejoining then return end
    isRejoining = true
    currentState = STATE.HOPPING
    local source = getScriptSource()
    if source then
        if queue_on_teleport then pcall(queue_on_teleport, source)
        elseif queueonteleport then pcall(queueonteleport, source)
        elseif syn and syn.queue_on_teleport then pcall(syn.queue_on_teleport, source) end
    end
    task.wait(2)
    if TeleportService then pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end) end
end

local function lookAtNearestPlayer()
    if not hrp then return end
    local nearest, nearestDist = nil, 100
    local players = Players:GetPlayers()
    for i = 1, #players do
        local p = players[i]
        if p ~= LocalPlayer and p.Character then
            local otherHrp = p.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local d = (hrp.Position - otherHrp.Position).Magnitude
                if d < nearestDist then nearest = otherHrp; nearestDist = d end
            end
        end
    end
    if nearest then
        local cam = safeWS.CurrentCamera
        if cam then
            pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, nearest.Position) end)
        end
    end
end

local function lookAroundRandomly()
    local cam = safeWS.CurrentCamera
    if not cam then return end
    pcall(function()
        cam.CFrame = cam.CFrame * CFrame.Angles(math.rad(rngNumber(-6, 6)), math.rad(rngNumber(-15, 15)), 0)
    end)
end

local function randomJump()
    if not hum then return end
    if clock() - humanBehavior.lastJump < 35 then return end
    if random() < 0.06 then hum.Jump = true; humanBehavior.lastJump = clock() end
end

local function varyWalkSpeed()
    if not hum then return end
    if clock() - humanBehavior.lastSpeedChange < 25 then return end
    humanBehavior.lastSpeedChange = clock()
    local mode = getObjectiveMode()
    local baseSpeed = brain.bestSpeed
    if mode == "STEALTH" then baseSpeed = baseSpeed - 3
    elseif mode == "SPEED" then baseSpeed = baseSpeed + 2 end
    humanBehavior.currentSpeed = baseSpeed + rngNumber(-0.8, 0.8)
    if hum.WalkSpeed ~= humanBehavior.currentSpeed then hum.WalkSpeed = humanBehavior.currentSpeed end
end

local function humanTick()
    if not hrp or not hum then return end
    updateDiscoveryRisk()
    local mode = getObjectiveMode()
    local lookChance = mode == "STEALTH" and 10 or 8
    if clock() - humanBehavior.lastLookAround > lookChance then
        humanBehavior.lastLookAround = clock()
        local r = random()
        if r < 0.06 then lookAroundRandomly()
        elseif r < 0.14 then lookAtNearestPlayer() end
    end
    if mode == "STEALTH" then
        if random() < 0.05 then hum.Jump = true end
    else randomJump() end
    varyWalkSpeed()
end

