local currentInitialLock

local function setupCharacter(char)
    if not char then return end

    clearCharacterConnections()

    if currentInitialLock and currentInitialLock.Connected then
        currentInitialLock:Disconnect()
    end

    character = char
    humanoid = character:WaitForChild("Humanoid", 10)
    hrp = character:WaitForChild("HumanoidRootPart", 10)

    if not humanoid or not hrp then return end

    character:PivotTo(SPAWN_TARGET)
    hrp.CFrame = SPAWN_TARGET
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    currentInitialLock = RunService.RenderStepped:Connect(function()
        if not hrp or not hrp.Parent then
            if currentInitialLock then currentInitialLock:Disconnect() end
            return
        end
        hrp.CFrame = SPAWN_TARGET
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    task.delay(0.15, function()
        if currentInitialLock and currentInitialLock.Connected then
            currentInitialLock:Disconnect()
        end
    end)

    trackChar(humanoid.Seated:Connect(function(active, seat)
        if not active or not seat then
            hideStatsBeforeExit()
            return
        end

        local driver = getDriver(seat)
        if driver ~= character then return end

        task.wait(0.3)

        local model, primaryPart = getVehicle(seat)
        if not model or not primaryPart then return end

        local changedVehicle = currentVehicle ~= model

        currentVehicle = model
        currentPrimaryPart = primaryPart

        if changedVehicle then
            savedVehicleCFrame = nil
            savedPhase = nil
        end

        showStatsAfterSeat()

        if paused then return end

        startCarLoop(model, primaryPart)
    end))

    trackChar(humanoid.Died:Connect(function()
        stopCarLoop()
    end))

    task.spawn(function()
        animateSpawnIn()
    end)

    task.wait(0.3)

    if humanoid and humanoid.Parent and humanoid.SeatPart then
        local driver = getDriver(humanoid.SeatPart)
        if driver == character then
            local model, primaryPart = getVehicle(humanoid.SeatPart)
            if model and primaryPart then
                currentVehicle = model
                currentPrimaryPart = primaryPart
                showStatsAfterSeat()
                startCarLoop(model, primaryPart)
            end
        end
    end
end

