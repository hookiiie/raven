local function getDistanceTo(targetPos)
    if not hrp then return huge end
    local p = hrp.Position
    local dx, dy, dz = p.X - targetPos.X, p.Y - targetPos.Y, p.Z - targetPos.Z
    return sqrt(dx*dx + dy*dy + dz*dz)
end

local function isNearPos(targetPos, radius)
    return getDistanceTo(targetPos) <= (radius or ARRIVE_DISTANCE)
end

local function isInEndpointZone(part)
    if not hrp then return false end
    local size, epPos, myPos = part.Size, part.Position, hrp.Position
    local dx = abs(myPos.X - epPos.X)
    local dz = abs(myPos.Z - epPos.Z)
    local dy = abs(myPos.Y - epPos.Y)
    return dx <= size.X * ZONE_XZ_RATIO and dz <= size.Z * ZONE_XZ_RATIO and dy <= size.Y * ZONE_XZ_RATIO + Y_TOLERANCE
end

local function castRay(origin, direction)
    if not raycastParams then initRaycastParams() end
    raycastParams.FilterDescendantsInstances = { char }
    return safeWS:Raycast(origin, direction, raycastParams)
end

local function checkAllObstacles()
    if not hrp then return false end
    local origin = hrp.Position
    local dirs = {
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        Vector3.new(1, 0, 1).Unit, Vector3.new(-1, 0, -1).Unit
    }
    for h = 1, #RAYCAST_HEIGHTS do
        local heightOffset = Vector3.new(0, RAYCAST_HEIGHTS[h], 0)
        for i = 1, #dirs do
            local result = castRay(origin + heightOffset, dirs[i] * NEAR_WALL_DISTANCE)
            if result and result.Distance < NEAR_WALL_DISTANCE - 1 then return true end
        end
    end
    return false
end

local function detectInvisibleObstacles()
    if not hrp then return false end
    local origin = hrp.Position
    local radius = INVISIBLE_DETECT_RADIUS
    local region = Region3.new(
        origin - Vector3.new(radius, radius, radius),
        origin + Vector3.new(radius, radius, radius)
    )
    local ok, parts = pcall(function()
        return safeWS:FindPartsInRegion3(region, char, 30)
    end)
    if not ok or not parts then return false end
    for i = 1, #parts do
        local part = parts[i]
        if part.CanCollide and part.Transparency > 0.85 and part.Size.Magnitude > 3 then
            return true
        end
    end
    return false
end

local function getSharedPath(targetPos)
    if not hrp or not PathfindingService then return nil end
    local now = clock()
    if lastTargetPos and (lastTargetPos - targetPos).Magnitude < 3 and sharedPath then
        local ok, status = pcall(function() return sharedPath.Status end)
        if ok and status == Enum.PathStatus.Success then return sharedPath end
    end
    if now - lastPathTime >= PATH_RECALC_TIME then
        lastPathTime = now
        lastTargetPos = targetPos
        if sharedPath then pcall(function() sharedPath:Destroy() end); sharedPath = nil end
        local path = PathfindingService:CreatePath(AGENT_PARAMS)
        local ok = pcall(function() path:ComputeAsync(hrp.Position, targetPos) end)
        if ok and path.Status == Enum.PathStatus.Success then sharedPath = path
        else sharedPath = nil end
    end
    return sharedPath
end

local function tryJumpIfStuck()
    local now = clock()
    if now - lastJumpTime < STUCK_JUMP_COOLDOWN then return end
    lastJumpTime = now
    if hum then hum.Jump = true end
end

local function walkDirectShort(targetPos, deliverCheck, arriveCheck)
    if not hum or not hrp then return false end
    local dist = getDistanceTo(targetPos)
    if dist > DIRECT_WALK_MAX_DIST then return false end

    hum.WalkSpeed = humanBehavior.currentSpeed

    local startTime = clock()
    local lastPos = hrp.Position
    local stuckCount = 0

    while clock() - startTime < 6 do
        if not hrp or not hum.Parent then return false end
        if deliverCheck and deliverCheck() then hum:MoveTo(hrp.Position); return true end
        if arriveCheck and arriveCheck() then hum:MoveTo(hrp.Position); return true end
        local currentPos = hrp.Position
        if isNearPos(targetPos) then hum:MoveTo(currentPos); return true end

        hum:MoveTo(targetPos)

        local dx, dy, dz = currentPos.X - lastPos.X, currentPos.Y - lastPos.Y, currentPos.Z - lastPos.Z
        local moved = sqrt(dx*dx + dy*dy + dz*dz)

        if moved < 0.15 then
            stuckCount = stuckCount + 1
            if stuckCount >= STUCK_THRESHOLD then
                tryJumpIfStuck()
                return false
            end
        else
            stuckCount = 0
        end
        lastPos = currentPos

        task.wait(WALK_TICK)
    end

    return false
end

local function walkPath(path, targetPos, deliverCheck, arriveCheck)
    if not hum or not hrp then return false end
    local waypoints = path:GetWaypoints()
    if #waypoints < 2 then return false end
    hum.WalkSpeed = humanBehavior.currentSpeed

    local currentIndex = 2
    local startTime = clock()
    local lastPos = hrp.Position
    local stuckCount = 0
    local lastProgress = startTime
    local wallCheckCounter = 0
    local invisibleCheckCounter = 0

    while clock() - startTime < MOVE_TIMEOUT do
        if not hrp or not hum.Parent then return false end
        if deliverCheck and deliverCheck() then hum:MoveTo(hrp.Position); return true end
        if arriveCheck and arriveCheck() then hum:MoveTo(hrp.Position); return true end
        local currentPos = hrp.Position
        if isNearPos(targetPos) then hum:MoveTo(currentPos); return true end

        if currentIndex > #waypoints then
            hum:MoveTo(targetPos)
            task.wait(0.1)
            hum:MoveTo(hrp.Position)
            return isNearPos(targetPos)
        end

        local waypoint = waypoints[currentIndex]
        local wpPos = waypoint.Position
        local distToWp = (currentPos - wpPos).Magnitude

        if distToWp <= WAYPOINT_REACHED then
            currentIndex = currentIndex + 1
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                hum.Jump = true
                task.wait(0.1)
            end
            if currentIndex <= #waypoints then
                local nextWp = waypoints[currentIndex]
                hum:MoveTo(nextWp.Position)
                if nextWp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
            end
        else
            hum:MoveTo(wpPos)
            if waypoint.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
        end

        wallCheckCounter = wallCheckCounter + 1
        if wallCheckCounter % WALL_CHECK_INTERVAL == 0 then
            nearWallFlag = checkAllObstacles()
        end

        invisibleCheckCounter = invisibleCheckCounter + 1
        if invisibleCheckCounter % INVISIBLE_CHECK_INTERVAL == 0 then
            if detectInvisibleObstacles() then
                nearWallFlag = true
                lastPathTime = 0
                sharedPath = nil
                return false
            end
        end

        local dx, dy, dz = currentPos.X - lastPos.X, currentPos.Y - lastPos.Y, currentPos.Z - lastPos.Z
        local moved = sqrt(dx*dx + dy*dy + dz*dz)

        if moved < 0.15 then
            stuckCount = stuckCount + 1
            if stuckCount >= STUCK_THRESHOLD then
                tryJumpIfStuck()
                stuckCount = 0
                rememberStuck(currentPos)
                lastPathTime = 0
                sharedPath = nil
                return false
            end
        else
            stuckCount = 0
            lastProgress = clock()
        end
        lastPos = currentPos

        if clock() - lastProgress > 5 then
            lastPathTime = 0
            sharedPath = nil
            return false
        end

        task.wait(WALK_TICK)
    end

    hum:MoveTo(hrp.Position)
    return isNearPos(targetPos)
end

local function walkTo(targetPos, deliverCheck, arriveCheck)
    if not hum or not hrp then return false end

    local dist = getDistanceTo(targetPos)

    if dist <= DIRECT_WALK_MAX_DIST then
        if walkDirectShort(targetPos, deliverCheck, arriveCheck) then return true end
    end

    local path = getSharedPath(targetPos)
    if path then
        if walkPath(path, targetPos, deliverCheck, arriveCheck) then return true end
    end

    sharedPath = nil
    lastPathTime = 0

    local path2 = getSharedPath(targetPos)
    if path2 then
        if walkPath(path2, targetPos, deliverCheck, arriveCheck) then return true end
    end

    return false
end

local function walkToPart(part, deliverCheck, arriveCheck)
    if not part then return false end
    if not part:IsA("BasePart") then
        local p = part:FindFirstChildWhichIsA("BasePart") or part.PrimaryPart
        if not p then return false end
        part = p
    end
    return walkTo(part.Position, deliverCheck, arriveCheck)
end

