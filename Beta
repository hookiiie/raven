local function isInCar()
    if not humanoid or not humanoid.Parent then return false end
    if humanoid.Health <= 0 then return false end
    if humanoid.Sit then return true end
    local seat = humanoid.SeatPart
    if seat and seat.Parent and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
        return true
    end
    if humanoid:GetState() == Enum.HumanoidStateType.Seated then
        return true
    end
    return false
end

local function updateControlButton()
    if paused then
        statsUI.control.Text = "START"
    else
        statsUI.control.Text = "STOP"
    end
end

local function showStatsAfterSeat()
    if System.minimized then
        System.minimized = false
        statsUI.restore.Visible = false
    end
    updateStats()
    updateControlButton()
    animateSpawnOut()
    task.delay(0.3, function()
        if isInCar() then
            animateStatsIn()
        end
    end)
end

local function hideStatsBeforeExit()
    if statsUI.holder.Visible then
        animateStatsOut()
    end
    task.delay(0.35, function()
        if not isInCar() then
            animateSpawnIn()
        end
    end)
end

local function setupUIDrag(frame)
    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    frame.InputBegan:Connect(function(input)
        if System.minimized then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or System.minimized then return end
        if input ~= dragInput then return end
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end

