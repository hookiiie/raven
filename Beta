local function logAdminBehavior(player, suspicion, reason)
    if not adminBehaviorLog[player.UserId] then
        adminBehaviorLog[player.UserId] = { score = 0, reasons = {} }
    end
    adminBehaviorLog[player.UserId].score = adminBehaviorLog[player.UserId].score + suspicion
    if reason then tableInsert(adminBehaviorLog[player.UserId].reasons, reason) end
    return adminBehaviorLog[player.UserId].score
end

local function detectAdminBehavior(player)
    if not player or not player.Character or not hrp then return 0, nil end
    local otherHrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not otherHrp then return 0, nil end
    local suspicion = 0
    local reason = nil
    local hum2 = player.Character:FindFirstChildOfClass("Humanoid")
    if hum2 and hum2.WalkSpeed > 50 then suspicion = suspicion + 5; reason = "سرعة عالية" end
    if hum2 and hum2.HipHeight > 5 then suspicion = suspicion + 4; reason = "HipHeight عالي" end
    if otherHrp.Transparency > 0.5 then suspicion = suspicion + 6; reason = "شفافية" end
    local dist = (hrp.Position - otherHrp.Position).Magnitude
    if dist < 15 and otherHrp.CanCollide == false then suspicion = suspicion + 2; reason = "CanCollide معطل" end
    if otherHrp.Size.Magnitude > 15 then suspicion = suspicion + 3; reason = "حجم كبير" end
    if otherHrp.AssemblyLinearVelocity.Magnitude > 100 then suspicion = suspicion + 3; reason = "سرعة حركة عالية" end
    return suspicion, reason
end

local function isPlayerAdmin(player)
    if not player or player == LocalPlayer then return false end
    if TARGET_GROUP_ID == 0 then return false end
    local cached = roleCache[player.UserId]
    if cached ~= nil then
        if cached == false then return false end
        return true, cached
    end
    local success, role = pcall(function() return player:GetRoleInGroup(TARGET_GROUP_ID) end)
    if success and role and role ~= "" then
        local roleLower = role:lower()
        for i = 1, #ADMIN_ROLE_LOWER do
            if roleLower == ADMIN_ROLE_LOWER[i] then
                roleCache[player.UserId] = "Role: " .. role
                return true, "Role: " .. role
            end
        end
    end
    local suspicion, behaviorReason = detectAdminBehavior(player)
    if suspicion > 0 then
        local totalScore = logAdminBehavior(player, suspicion, behaviorReason)
        if totalScore >= 8 then
            roleCache[player.UserId] = "Behavior: " .. behaviorReason
            return true, "Behavior: " .. behaviorReason
        end
    end
    roleCache[player.UserId] = false
    return false
end

local function checkForAdmins()
    if not SERVER_HOP_ENABLED then return false end
    local players = Players:GetPlayers()
    for i = 1, #players do
        local player = players[i]
        if player ~= LocalPlayer and not detectedAdmins[player.UserId] then
            local isAdmin, reason = isPlayerAdmin(player)
            if isAdmin then
                detectedAdmins[player.UserId] = true
                print("⚠️ لقطت ادمن: " .. player.Name .. " (" .. reason .. ")")
                return true, reason
            end
        end
    end
    return false
end

