local function getChest()
    local c = cache.chest
    if c and c.Parent then return c end
    local s = getStarter()
    if not s then return nil end
    cache.chest = s:FindFirstChild("TakeChest")
    cache.chestPos = cache.chest and cache.chest.Position or nil
    return cache.chest
