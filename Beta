local function getVehicle(seat)
    if not seat then return nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    while model do
        if model.PrimaryPart then
            return model, model.PrimaryPart
        end
        local vs = model:FindFirstChildWhichIsA("VehicleSeat", true)
        if vs then
            if not model.PrimaryPart then
                model.PrimaryPart = vs
            end
            return model, model.PrimaryPart
        end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return nil
end

local function getDriver(seat)
    if not seat then return nil end
    local weld = seat:FindFirstChild("SeatWeld")
    if not weld then return nil end
    local part0 = weld.Part1
    if part0 and part0.Parent and part0.Parent:FindFirstChild("Humanoid") then
        return part0.Parent
    end
    return nil
end

local function takeNetworkOwner(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part:SetNetworkOwner(player)
            end)
        end
    end
end

local function freezeAllParts(model)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function killWheelMotors(model)
    local saved = {}
    for _, c in ipairs(model:GetDescendants()) do
        if c:IsA("HingeConstraint") and c.ActuatorType == Enum.ActuatorType.Motor then
            table.insert(saved, { c = c, v = c.AngularVelocity })
            c.AngularVelocity = 0
        end
        if c:IsA("Motor6D") then
            table.insert(saved, { c = c, v = c.CurrentAngle })
        end
    end
    return saved
end

local function restoreWheelMotors(saved)
    for _, entry in ipairs(saved) do
        if entry.c and entry.c.Parent then
            if entry.c:IsA("HingeConstraint") then
                entry.c.AngularVelocity = entry.v
            end
        end
    end
end

local function teleportVehicleSafely(model, primaryPart, targetCFrame)
    takeNetworkOwner(model)
    local savedMotors = killWheelMotors(model)
    local connection

    connection = RunService.RenderStepped:Connect(function()
        if not model or not model.Parent then
            if connection then connection:Disconnect() end
            return
        end
        if not primaryPart or not primaryPart.Parent then
            if connection then connection:Disconnect() end
            return
        end
        model:PivotTo(targetCFrame)
        freezeAllParts(model)
    end)

    task.delay(CONFIG.TeleportLockTime, function()
        if connection and connection.Connected then
            connection:Disconnect()
        end
        if model and model.Parent then
            freezeAllParts(model)
        end
        restoreWheelMotors(savedMotors)
    end)
end

local function driveTo(model, primaryPart, targetPosition, myGen)
    local startTime = os.clock()
    local connection
    local finished = false

    connection = RunService.Heartbeat:Connect(function(dt)
        if myGen ~= driveGen or paused or not isDriving then
            if connection then connection:Disconnect() end
            return
        end
        if not primaryPart or not primaryPart.Parent then
            if connection then connection:Disconnect() end
            return
        end
        if os.clock() - startTime > CONFIG.MaxDriveTime then
            if connection then connection:Disconnect() end
            return
        end

        local current = primaryPart.Position
        local flatCurrent = Vector3.new(current.X, 0, current.Z)
        local flatTarget = Vector3.new(targetPosition.X, 0, targetPosition.Z)
        local delta = flatTarget - flatCurrent
        local distance = delta.Magnitude

        if distance > 0.5 then
            local dir = delta.Unit
            local currentCF = primaryPart.CFrame
            local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + dir)
            local alpha = math.min(1, CONFIG.RotationSpeed * dt)
            primaryPart.CFrame = currentCF:Lerp(targetCF, alpha)
        end

        if distance <= CONFIG.ArriveThreshold then
            local currentVel = primaryPart.AssemblyLinearVelocity
            local slowFactor = math.clamp(distance / CONFIG.ArriveThreshold, 0, 1)
            primaryPart.AssemblyLinearVelocity = Vector3.new(
                currentVel.X * slowFactor,
                currentVel.Y,
                currentVel.Z * slowFactor
            )
            if distance <= 0.6 then
                freezeAllParts(model)
                finished = true
                if connection then connection:Disconnect() end
            end
            return
        end

        local direction = delta.Unit
        local targetSpeed = CONFIG.CruiseSpeed

        if distance < CONFIG.BrakingDistance then
            local ratio = distance / CONFIG.BrakingDistance
            targetSpeed = math.max(8, targetSpeed * ratio)
        end

        local desiredVel = direction * targetSpeed
        local currentVel = primaryPart.AssemblyLinearVelocity
        local currentFlatVel = Vector3.new(currentVel.X, 0, currentVel.Z)
        local velDiff = desiredVel - currentFlatVel
        local maxDelta = CONFIG.Acceleration * dt

        if velDiff.Magnitude > maxDelta then
            velDiff = velDiff.Unit * maxDelta
        end

        local newFlatVel = currentFlatVel + velDiff

        primaryPart.AssemblyLinearVelocity = Vector3.new(
            newFlatVel.X,
            currentVel.Y,
            newFlatVel.Z
        )
    end)

    while connection and connection.Connected do
        task.wait(0.05)
        if myGen ~= driveGen or paused or not isDriving then
            break
        end
    end

    return finished
end

local function startCarLoop(model, primaryPart)
    if not model or not primaryPart then return end
    currentVehicle = model
    currentPrimaryPart = primaryPart
    if isDriving then return end

    savedVehicleCFrame = nil
    savedPhase = nil

    paused = false
    isDriving = true
    driveGen += 1
    local myGen = driveGen

    task.spawn(function()
        while isDriving and not paused and myGen == driveGen do
            if not currentVehicle or not currentVehicle.Parent then
                isDriving = false
                break
            end
            if not currentPrimaryPart or not currentPrimaryPart.Parent then
                isDriving = false
                break
            end

            if currentPhase == "IDLE" or currentPhase == "RETURN_TO_A" then
                currentPhase = "MOVING_TO_A"
                teleportVehicleSafely(currentVehicle, currentPrimaryPart, POINT_A.CFrame)
                task.wait(CONFIG.TeleportLockTime + CONFIG.SettleTime)
                if paused or not isDriving or myGen ~= driveGen then break end
                currentPhase = "MOVING_TO_B"
            end

            if currentPhase == "MOVING_TO_B" then
                driveTo(currentVehicle, currentPrimaryPart, POINT_B.Position, myGen)
                if paused or not isDriving or myGen ~= driveGen then break end

                if currentPrimaryPart and currentPrimaryPart.Parent then
                    local distance = (
                        Vector3.new(currentPrimaryPart.Position.X, 0, currentPrimaryPart.Position.Z) -
                        Vector3.new(POINT_B.Position.X, 0, POINT_B.Position.Z)
                    ).Magnitude
                    if distance <= CONFIG.ArriveThreshold then
                        currentPhase = "RETURN_TO_A"
                    end
                end
            end
        end
    end)
end

function stopCarLoop()
    paused = true
    isDriving = false
    driveGen += 1

    if currentPrimaryPart and currentPrimaryPart.Parent then
        currentPrimaryPart.AssemblyLinearVelocity = Vector3.zero
        currentPrimaryPart.AssemblyAngularVelocity = Vector3.zero

        savedVehicleCFrame = currentPrimaryPart.CFrame
        savedPhase = currentPhase
    end
end

function resumeCarLoop()
    if not currentVehicle or not currentVehicle.Parent then return end
    if not currentPrimaryPart or not currentPrimaryPart.Parent then return end
    if isDriving then return end

    if savedVehicleCFrame then
        local moved = (currentPrimaryPart.Position - savedVehicleCFrame.Position).Magnitude
        if moved > 2 then
            currentPrimaryPart.CFrame = savedVehicleCFrame
            currentPrimaryPart.AssemblyLinearVelocity = Vector3.zero
            currentPrimaryPart.AssemblyAngularVelocity = Vector3.zero
        end
    end

    if savedPhase then
        currentPhase = savedPhase
        savedPhase = nil
    end

    paused = false
    isDriving = true
    driveGen += 1
    local myGen = driveGen

    task.spawn(function()
        while isDriving and not paused and myGen == driveGen do
            if not currentVehicle or not currentVehicle.Parent then
                isDriving = false
                break
            end
            if not currentPrimaryPart or not currentPrimaryPart.Parent then
                isDriving = false
                break
            end

            if currentPhase == "MOVING_TO_B" then
                driveTo(currentVehicle, currentPrimaryPart, POINT_B.Position, myGen)
                if paused or not isDriving or myGen ~= driveGen then break end
                if currentPrimaryPart and currentPrimaryPart.Parent then
                    local distance = (
                        Vector3.new(currentPrimaryPart.Position.X, 0, currentPrimaryPart.Position.Z) -
                        Vector3.new(POINT_B.Position.X, 0, POINT_B.Position.Z)
                    ).Magnitude
                    if distance <= CONFIG.ArriveThreshold then
                        currentPhase = "RETURN_TO_A"
                    end
                end
            elseif currentPhase == "RETURN_TO_A" or currentPhase == "IDLE" then
                currentPhase = "MOVING_TO_A"
                teleportVehicleSafely(currentVehicle, currentPrimaryPart, POINT_A.CFrame)
                task.wait(CONFIG.TeleportLockTime + CONFIG.SettleTime)
                if paused or not isDriving or myGen ~= driveGen then break end
                currentPhase = "MOVING_TO_B"
            else
                currentPhase = "MOVING_TO_B"
            end
        end
    end)
end

