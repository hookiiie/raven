local function rememberEvent(eventType, data)
    tableInsert(brain.recentEvents, { type = eventType, data = data, time = clock() })
    if #brain.recentEvents > 60 then tableRemove(brain.recentEvents, 1) end
end

local function getRecentSuccessRate(n)
    n = min(n, #brain.recentEvents)
    if n == 0 then return 0.5 end
    local successes = 0
    for i = #brain.recentEvents, #brain.recentEvents - n + 1, -1 do
        if brain.recentEvents[i].type == "success" then successes = successes + 1 end
    end
    return successes / n
end

local function calculateConfidence()
    local total = brain.totalCycles
    if total < 3 then return 0.5 end
    local allTimeRate = brain.successfulCycles / total
    local recentRate = getRecentSuccessRate(15)
    local rate = allTimeRate * 0.35 + recentRate * 0.65
    local streakBonus = min(brain.streak * 0.06, 0.35)
    return min(max(rate + streakBonus, 0), 1)
end

local function updateDiscoveryRisk()
    if not hrp then return end
    local risk = 0
    local players = Players:GetPlayers()
    for i = 1, #players do
        local p = players[i]
        if p ~= LocalPlayer and p.Character then
            local otherHrp = p.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local dist = (hrp.Position - otherHrp.Position).Magnitude
                if dist < 35 then risk = risk + (35 - dist) / 35 end
            end
        end
    end
    brain.discoveryRisk = min(risk, 1)
end

local function updateEndpointScore(endpointName, success, deliveryTime)
    if not brain.endpointScores[endpointName] then
        brain.endpointScores[endpointName] = { wins = 0, losses = 0, avgTime = 3 }
        brain.endpointAttempts[endpointName] = 0
        brain.endpointWeights[endpointName] = 1.0
    end
    local score = brain.endpointScores[endpointName]
    brain.endpointAttempts[endpointName] = brain.endpointAttempts[endpointName] + 1
    if success then
        score.wins = score.wins + 1
        if deliveryTime then score.avgTime = score.avgTime * 0.75 + deliveryTime * 0.25 end
    else
        score.losses = score.losses + 1
    end
    local total = score.wins + score.losses
    if total > 0 then
        local winRate = score.wins / total
        local speedBonus = max(0, (5 - score.avgTime) / 5) * 0.3
        brain.endpointWeights[endpointName] = winRate + speedBonus
    end
    if success and (not brain.bestEndpoint or score.wins > (brain.endpointScores[brain.bestEndpoint] or {}).wins or 0) then
        brain.bestEndpoint = endpointName
    end
end

local function pickBestEndpoint(endpoints)
    if #endpoints == 0 then return nil end
    local best, bestScore = nil, -1
    for i = 1, #endpoints do
        local ep = endpoints[i]
        local weight = brain.endpointWeights[ep.Name] or 1.0
        local attempts = brain.endpointAttempts[ep.Name] or 0
        local explorationBonus = sqrt(2 * math.log(brain.totalCycles + 1) / (attempts + 1))
        local totalScore = weight + explorationBonus * 0.3
        if totalScore > bestScore then bestScore = totalScore; best = ep end
    end
    return best or endpoints[1]
end

local function adaptOnSuccess(deliveryTime)
    brain.successfulCycles = brain.successfulCycles + 1
    brain.streak = brain.streak + 1
    brain.failStreak = 0
    brain.totalDeliveries = brain.totalDeliveries + 1
    brain.confidence = calculateConfidence()
    if deliveryTime then
        brain.averageDeliveryTime = brain.averageDeliveryTime * 0.8 + deliveryTime * 0.2
        if deliveryTime < 3 then brain.consecutiveFastDeliveries = brain.consecutiveFastDeliveries + 1
        else brain.consecutiveFastDeliveries = 0 end
    end
    rememberEvent("success", { confidence = brain.confidence, time = deliveryTime })
    if brain.streak >= 3 then
        brain.takeAttempts = max(6, brain.takeAttempts - 2)
        brain.deliverAttempts = max(6, brain.deliverAttempts - 2)
        brain.streak = 0
    end
    local speedTarget = brain.discoveryRisk > 0.5 and 0.95 or 0.85
    if brain.confidence > speedTarget then brain.bestSpeed = min(26, brain.bestSpeed + 0.4) end
    if brain.lastCycleTime < brain.bestCycleTime then brain.bestCycleTime = brain.lastCycleTime end
end

local function adaptOnFail(reason)
    brain.failedCycles = brain.failedCycles + 1
    brain.failStreak = brain.failStreak + 1
    brain.streak = 0
    brain.confidence = calculateConfidence()
    rememberEvent("fail", { reason = reason, confidence = brain.confidence })
    if brain.failStreak >= 2 then
        brain.takeAttempts = min(30, brain.takeAttempts + 3)
        brain.deliverAttempts = min(30, brain.deliverAttempts + 3)
    end
    if brain.confidence < 0.4 then brain.bestSpeed = max(20, brain.bestSpeed - 0.4) end
end

local function profileServer(pingTime)
    brain.serverPing = brain.serverPing * 0.88 + pingTime * 0.12
    if brain.serverPing < 70 then brain.serverSpeed = 1.4; brain.serverQuality = 1.0
    elseif brain.serverPing < 130 then brain.serverSpeed = 1.15; brain.serverQuality = 0.9
    elseif brain.serverPing < 220 then brain.serverSpeed = 0.9; brain.serverQuality = 0.7
    elseif brain.serverPing < 350 then brain.serverSpeed = 0.7; brain.serverQuality = 0.5
    else brain.serverSpeed = 0.5; brain.serverQuality = 0.3 end
end

local function getObjectiveMode()
    if brain.discoveryRisk > 0.7 then return "STEALTH" end
    if brain.confidence < 0.3 then return "CAREFUL" end
    if brain.confidence > 0.85 and brain.discoveryRisk < 0.3 then return "SPEED" end
    return "BALANCED"
end

local function isNearKnownStuck(pos)
    local now = clock()
    for i = #brain.stuckPositions, 1, -1 do
        local entry = brain.stuckPositions[i]
        if now - entry.time > STUCK_EXPIRY then tableRemove(brain.stuckPositions, i)
        elseif (entry.pos - pos).Magnitude < 5 then return true end
    end
    return false
end

local function rememberStuck(pos)
    if isNearKnownStuck(pos) then return end
    tableInsert(brain.stuckPositions, { pos = pos, time = clock() })
    if #brain.stuckPositions > 6 then tableRemove(brain.stuckPositions, 1) end
end

